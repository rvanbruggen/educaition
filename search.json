---
layout: null
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "excerpt": {% capture ez %}{% include eerste-zin.html item=post %}{% endcapture %}{{ ez | strip | jsonify }},
    "image": {{ post.image | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }},
    "niveau": {{ post.niveau | jsonify }},
    "vak": {{ post.vak | jsonify }},
    "thema": {{ post.thema | jsonify }},
    "regio": {{ post.regio | jsonify }},
    "type": {{ post.type | jsonify }},
    "doelgroep": {{ post.doelgroep | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
